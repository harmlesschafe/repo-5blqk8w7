    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot1:SIG", "esp:34", "green", [ "v0" ] ],
    [ "esp:25", "r1:1", "red", [ "h0" ] ],
    [ "r1:2", "rgb1:R", "red", [ "v0" ] ],
    [ "esp:26", "r2:1", "green", [ "h0" ] ],
    [ "r2:2", "rgb1:G", "green", [ "v0" ] ],
    [ "esp:27", "r3:1", "blue", [ "h0" ] ],
    [ "r3:2", "rgb1:B", "blue", [ "v0" ] ],
    [ "rgb1:COM", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
