{
  "version": 1,
  "author": "第七次课 MQTT 练习",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -120, "left": -160, "attrs": { "value": "512" } },
    { "type": "wokwi-rgb-led", "id": "rgb1", "top": -110, "left": 230, "attrs": { "common": "cathode" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 40, "left": 190, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 40, "left": 220, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 40, "left": 250, "rotate": 90, "attrs": { "value": "220" } }
